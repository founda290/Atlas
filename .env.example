# Vite reads .env.local automatically. Only this PUBLIC service URL belongs in VITE_*.
# Copy the actual Neon Auth URL from Neon/Vercel, including its auth base path.
VITE_NEON_AUTH_URL=

# Optional local backend variables: export these in the shell that starts Node.
# Node server:start does NOT automatically load .env.local.
# DATABASE_URL=
# ATLAS_DATABASE_MIGRATE=0
# ATLAS_DATA_DIR=.atlas
# ATLAS_WORKSPACE_ROOT=

# Future cloud verification only; not needed for browser-local editing or signup.
# Set server-only values from the actual provider metadata, never guess issuer/audience.
# NEON_AUTH_JWKS_URL=
# NEON_AUTH_ISSUER=
# NEON_AUTH_AUDIENCE=
# There is intentionally NO cloud activation environment variable in this release.
